local humanoid
local afkEnabled, noclipEnabled, espEnabled, infoEnabled = false, false, false, false
local angle = 0

local function setupChar(char)
    humanoid = char:WaitForChild("Humanoid")
end
setupChar(player.Character or player.CharacterAdded:Wait())
player.CharacterAdded:Connect(setupChar)

RunService.RenderStepped:Connect(function(dt)
    if afkEnabled and humanoid then
        angle += dt * 1.5
        humanoid:Move(Vector3.new(math.cos(angle),0,math.sin(angle)),false)
    end
end)

RunService.Stepped:Connect(function()
    if noclipEnabled and player.Character then
        for _,v in ipairs(player.Character:GetDescendants()) do
            if v:IsA("BasePart") then v.CanCollide = false end
        end
    end
end)

local function Notify(text)
    local notif = Instance.new("Frame", gui)
    notif.Size = UDim2.new(0, 200, 0, 40)
    notif.Position = UDim2.new(1, 20, 1, -60)
    notif.BackgroundColor3 = THEME.DarkBg
    notif.BackgroundTransparency = 0.2
    notif.ZIndex = 2000
    Instance.new("UICorner", notif).CornerRadius = UDim.new(0, 10)
    
    local line = Instance.new("Frame", notif)
    line.Size = UDim2.new(0, 4, 1, 0)
    line.BackgroundColor3 = THEME.MainPink
    Instance.new("UICorner", line)
    
    local txt = Instance.new("TextLabel", notif)
    txt.Size = UDim2.new(1, -15, 1, 0)
    txt.Position = UDim2.new(0, 10, 0, 0)
    txt.Text = "💖 "..text
    txt.TextColor3 = Color3.new(1,1,1)
    txt.Font = Enum.Font.GothamBold
    txt.TextSize = 12
    txt.BackgroundTransparency = 1
    txt.TextXAlignment = Enum.TextXAlignment.Left
    
    notif:TweenPosition(UDim2.new(1, -210, 1, -60), "Out", "Back", 0.5, true)
    task.spawn(function()
        task.wait(3)
        notif:TweenPosition(UDim2.new(1, 20, 1, -60), "In", "Quad", 0.5, true)
        task.wait(0.5)
        notif:Destroy()
    end)
end

