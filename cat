local function addToggle(text, index, callback)
    local frame = Instance.new("Frame", mainContent)
    frame.Size = UDim2.new(1, -20, 0, 42)
    frame.Position = UDim2.new(0, 10, 0, 15 + (index-1)*48)
    frame.BackgroundTransparency = 1

    local lbl = Instance.new("TextLabel", frame)
    lbl.Size = UDim2.new(0.6, 0, 1, 0)
    lbl.Text = text
    lbl.Font = Enum.Font.GothamBold
    lbl.TextColor3 = Color3.new(1,1,1)
    lbl.TextSize = 13
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.BackgroundTransparency = 1

    local sw = Instance.new("TextButton", frame)
    sw.Size = UDim2.new(0, 38, 0, 20)
    sw.Position = UDim2.new(1, -40, 0.5, -10)
    sw.BackgroundColor3 = THEME.ToggleOff
    sw.Text = ""
    Instance.new("UICorner", sw).CornerRadius = UDim.new(1, 0)

    local dot = Instance.new("Frame", sw)
    dot.Size = UDim2.new(0, 14, 0, 14)
    dot.Position = UDim2.new(0, 3, 0.5, -7)
    dot.BackgroundColor3 = Color3.new(1,1,1)
    Instance.new("UICorner", dot).CornerRadius = UDim.new(1, 0)

    local active = false
    sw.MouseButton1Click:Connect(function()
        active = not active
        TweenService:Create(dot, TweenInfo.new(0.2), {Position = active and UDim2.new(1, -17, 0.5, -7) or UDim2.new(0, 3, 0.5, -7)}):Play()
        TweenService:Create(sw, TweenInfo.new(0.2), {BackgroundColor3 = active and THEME.ToggleOn or THEME.ToggleOff}):Play()
        Notify(text..": "..(active and "Enabled" or "Disabled"))
        callback(active)
    end)
end

local function addActionBtn(text, index, color, callback)
    local btn = Instance.new("TextButton", mainContent)
    btn.Size = UDim2.new(1, -20, 0, 35)
    btn.Position = UDim2.new(0, 10, 0, 220 + (index-1)*45)
    btn.BackgroundColor3 = color
    btn.Text = "💖 "..text.." 💖"
    btn.Font = Enum.Font.GothamBold
    btn.TextColor3 = Color3.new(1,1,1)
    btn.TextSize = 12
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)
    btn.MouseButton1Click:Connect(function()
        Notify("Running: "..text)
        callback()
    end)
end

